{
	default_sni {$RACOONIX_SNI}
}

(sicurezza) {
	tls internal {
		protocols tls1.2 tls1.3
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
}

# Racoonix: il prodotto
{$RACOONIX_HOST} {
	import sicurezza
	reverse_proxy app:8000
}

# Simulatore: le apparecchiature del negozio (ambiente demo separato)
{$RACOONIX_SIM_HOST} {
	import sicurezza
	reverse_proxy simulatore:5000
}
